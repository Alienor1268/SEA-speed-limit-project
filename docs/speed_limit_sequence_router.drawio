ze=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1094.0" y="764" as="sourcePoint"/><mxPoint x="506.0" y="764" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="12: tool result: air-quality index" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="810" as="sourcePoint"/><mxPoint x="894.0" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="13: tool call: getAccidents(last 24 h)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="894.0" y="856" as="sourcePoint"/><mxPoint x="506.0" y="856" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="14: query accidents / near-accidents" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="494.0" y="902" as="sourcePoint"/><mxPoint x="306.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="15: accidents / near-accidents" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="306.0" y="948" as="sourcePoint"/><mxPoint x="494.0" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="16: tool result: accidents" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="994" as="sourcePoint"/><mxPoint x="894.0" y="994" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="17: decide reduction" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;fontSize=11;rounded=0;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="906.0" y="1040" as="sourcePoint"/><mxPoint x="906.0" y="1060" as="targetPoint"/><Array as="points"><mxPoint x="940.0" y="1040"/><mxPoint x="940.0" y="1060"/></Array></mxGeometry></mxCell><mxCell id="c39" value="18: reduction: 0, 10, 20, 30 or 40 km/h" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="894.0" y="1090" as="sourcePoint"/><mxPoint x="506.0" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="19: validate LLM answer;&lt;br&gt;final limit = lowest (NN limit, 80 − reduction)" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;fontSize=11;rounded=0;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="1136" as="sourcePoint"/><mxPoint x="506.0" y="1156" as="targetPoint"/><Array as="points"><mxPoint x="540.0" y="1136"/><mxPoint x="540.0" y="1156"/></Array></mxGeometry></mxCell><mxCell id="c41" value="20: save decision (limit, reason)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="494.0" y="1202" as="sourcePoint"/><mxPoint x="306.0" y="1202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="21: display speed limit + reason" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="1248" as="sourcePoint"/><mxPoint x="1294.0" y="1248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=22;fontSize=11;fontStyle=1;fillColor=none;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="210.0" y="166" width="1190.0" height="1138" as="geometry"/></mxCell><mxCell id="c44" value="[every hour]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="262.0" y="169" width="120" height="18" as="geometry"/></mxCell><mxCell id="c45" value="Given: the neural network shall only be used if it is dark or the weather is bad. The LLM is used for air quality only, because there is not enough data to train a model." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#FFF8E1;strokeColor=#B59B50;" vertex="1" parent="1"><mxGeometry x="840.0" y="322" width="300" height="70" as="geometry"/></mxCell><mxCell id="c46" value="Air quality is checked every hour (REQ2), even when it is light and the weather is good. The LLM cannot call APIs itself: it asks the agent for a tool call, the agent runs it and returns the result." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#FFF8E1;strokeColor=#B59B50;" vertex="1" parent="1"><mxGeometry x="1180.0" y="666" width="240" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>