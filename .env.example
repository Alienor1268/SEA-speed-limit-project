# Copy this file to ".env" and fill in your key to let the LLM decide the air-quality reduction.
# Without a key the Air Quality Service uses the fixed rule (fallback, REQ13).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Training data of the neural network: N (first model) or N,N+1 (retrained, slide 20)
TRAIN_YEARS=N,N+1
